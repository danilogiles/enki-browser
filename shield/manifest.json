{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.2.9",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/shield16.png", "32": "icons/shield32.png" }
  },
  "icons": { "16": "icons/shield16.png", "32": "icons/shield32.png", "48": "icons/shield48.png", "128": "icons/shield128.png" },
  "options_page": "options.html",
  "permissions": ["declarativeNetRequest", "webNavigation", "webRequest", "tabs", "storage", "alarms", "contentSettings", "browsingData", "nativeMessaging", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": { "rule_resources": [{ "id": "omnibox", "enabled": true, "path": "rules/omnibox.json" }, { "id": "amp", "enabled": true, "path": "amp.json" }, { "id": "webstore", "enabled": true, "path": "rules/webstore.json" }] },
  "content_scripts": [{ "matches": ["https://*/*", "http://*/*"], "js": ["amp.js"], "run_at": "document_end" }, { "matches": ["https://chromewebstore.google.com/*"], "js": ["webstore-page.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
